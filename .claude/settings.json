{
	"permissions": {
		"deny": [
			"Bash(npm run build)",
			"Bash(npm run build:*)",
			"Bash(npm run check)",
			"Bash(npm run check:*)",
			"Bash(npm run lint)",
			"Bash(npm run lint:*)",
			"Bash(npm run test)",
			"Bash(npm run test:*)",
			"Bash(npm run format)",
			"Bash(npm run format:*)",
			"Bash(npx prettier:*)",
			"Bash(npx eslint:*)",
			"Bash(npx svelte-check:*)",
			"Bash(npx tsc:*)",
			"Bash(npx vite:*)",
			"Bash(npx vitest:*)",
			"Bash(npx playwright:*)",
			"Bash(prettier:*)",
			"Bash(eslint:*)",
			"Bash(svelte-check:*)",
			"Bash(tsc:*)",
			"Bash(vite:*)",
			"Bash(vitest:*)",
			"Bash(pnpm build:*)",
			"Bash(pnpm check:*)",
			"Bash(pnpm lint:*)",
			"Bash(pnpm test:*)",
			"Bash(yarn build:*)",
			"Bash(yarn check:*)",
			"Bash(yarn lint:*)",
			"Bash(yarn test:*)"
		]
	},
	"hooks": {
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "jq -Rn --rawfile rules \"$CLAUDE_PROJECT_DIR/CLAUDE.md\" '{hookSpecificOutput:{hookEventName:\"UserPromptSubmit\",additionalContext:(\"MANDATORY output rules for this response:\\n\" + $rules)}}' 2>/dev/null || true"
					}
				]
			}
		]
	}
}
